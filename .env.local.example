# LodgeFlow local Docker development environment
# Copy this file to .env.local. These values are for LOCAL QA ONLY.
DEBUG=true
DJANGO_SECRET_KEY=local-development-secret-change-before-any-shared-environment-20260823
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
FRONTEND_BASE_URL=http://localhost:3000
INVITATION_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

POSTGRES_DB=lodgeflow
POSTGRES_USER=lodgeflow
POSTGRES_PASSWORD=lodgeflow-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_PASSWORD=lodgeflow-redis-local-only
REDIS_URL=redis://:lodgeflow-redis-local-only@redis:6379/0
CELERY_BROKER_URL=redis://:lodgeflow-redis-local-only@redis:6379/0
CELERY_RESULT_BACKEND=redis://:lodgeflow-redis-local-only@redis:6379/1

# Deterministic LOCAL-ONLY Fernet key. Replace in every non-local environment.
CREDENTIAL_ENCRYPTION_KEYS=R3VMfPkzP-6ke1Cjn66SeWgSaoHAARosPtZDLSLQ1oI=

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=LodgeFlow Local <noreply@localhost>

# Local malware scanner. Set false if you temporarily disable the ClamAV service.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# Local demo account generated by seed_local_demo.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_EMAIL=admin@lodgeflow.local
LOCAL_ADMIN_PASSWORD=LodgeFlowLocal123!
LOCAL_ROLE_PASSWORD=LodgeFlowLocal123!
LOCAL_TENANT_NAME=Harmony Lodge
LOCAL_TENANT_SLUG=harmony-lodge
LOCAL_TENANT_NUMBER=1001
LOCAL_TENANT_JURISDICTION=Local QA
