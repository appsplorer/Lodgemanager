DEBUG=false
DJANGO_SECRET_KEY=replace-with-64-plus-random-characters
CREDENTIAL_ENCRYPTION_KEYS=replace-with-fernet-key
ALLOWED_HOSTS=app.yourdomain.com,backend
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
POSTGRES_DB=lodgeflow
POSTGRES_USER=lodgeflow
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-strong-password
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
FRONTEND_BASE_URL=https://app.yourdomain.com
INVITATION_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
APP_HTTP_PORT=8080
# Recommended private object storage; leave empty only if using the persistent Docker media volume.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-southeast-1
AWS_S3_ENDPOINT_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=LodgeFlow <noreply@yourdomain.com>

CLAMAV_REQUIRED=true
# Host-side backup/restore scripts require a chmod-600 secret file containing a long random passphrase.
BACKUP_ENCRYPTION_PASSWORD_FILE=/etc/lodgeflow/backup-passphrase
BACKUP_MEDIA_MODE=auto
BACKUP_RETENTION_DAYS=35
# Optional absolute executable; receives the completed backup bundle path for off-server transfer.
BACKUP_TRANSFER_EXECUTABLE=
# Required for an S3 restore; receives the decrypted, verified inventory JSON path.
BACKUP_S3_RESTORE_EXECUTABLE=

# Optional error tracking (store the real DSN only in deployment secrets).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# External monitoring/alert receiver used by scripts/ops-monitor.py.
PUBLIC_BASE_URL=https://app.yourdomain.com
ALERT_WEBHOOK_URL=
TLS_WARN_DAYS=21
BACKUP_STATUS_FILE=/var/lib/lodgeflow-backups/latest-success.json
BACKUP_MAX_AGE_HOURS=26
DISK_MONITOR_PATH=/var/lib/lodgeflow-backups
DISK_WARN_PERCENT=85
