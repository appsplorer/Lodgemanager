DEBUG=false
DJANGO_SECRET_KEY=replace-with-64-plus-random-characters
CREDENTIAL_ENCRYPTION_KEYS=replace-with-fernet-key
ALLOWED_HOSTS=staging.yourdomain.com,backend
CSRF_TRUSTED_ORIGINS=https://staging.yourdomain.com
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com
POSTGRES_DB=lodgeflow
POSTGRES_USER=lodgeflow
POSTGRES_PASSWORD=replace-with-strong-staging-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-strong-staging-redis-password
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=0
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
FRONTEND_BASE_URL=https://staging.yourdomain.com
INVITATION_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
APP_HTTP_PORT=8080
STAGING_S3_BUCKET=lodgeflow-staging
STAGING_S3_ACCESS_KEY=lodgeflow-staging
STAGING_S3_SECRET_KEY=replace-with-strong-staging-s3-secret
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=LodgeFlow Staging <noreply@staging.local>
CLAMAV_REQUIRED=true
